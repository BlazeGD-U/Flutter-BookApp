{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "lastChatMessageAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "books": {
      ".read": "auth != null",
      ".indexOn": ["userId"],
      "$bookId": {
        ".write": "auth != null && (data.child('userId').val() === auth.uid || !data.exists())"
      }
    },
    "recommendations": {
      ".read": true,
      ".write": false
    },
    "notifications": {
      ".read": "auth != null",
      ".indexOn": ["userId", "bookId"],
      "$notificationId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && (data.child('userId').val() === auth.uid || !data.exists())"
      }
    },
    "globalChat": {
      ".read": "auth != null",
      ".indexOn": ["createdAtMs"],
      "$messageId": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000 && newData.child('createdAtMs').isNumber() && (!root.child('users').child(auth.uid).child('lastChatMessageAt').exists() || (now - root.child('users').child(auth.uid).child('lastChatMessageAt').val() >= 120000))) || (data.exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['userId', 'userName', 'text', 'createdAtMs'])"
      }
    },
    "globalChatMeta": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
